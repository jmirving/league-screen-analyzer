<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LeagueScreenAnalyzer.Core\LeagueScreenAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Capture\LeagueScreenAnalyzer.Capture.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Imaging\LeagueScreenAnalyzer.Imaging.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Storage\LeagueScreenAnalyzer.Storage.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\fixtures\clocks\league-replay-v2\**\*"
             Link="fixtures\clocks\league-replay-v2\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
