<Window x:Class="LeagueScreenAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:LeagueScreenAnalyzer.App.ViewModels"
        mc:Ignorable="d"
        Title="League Screen Analyzer"
        Height="560"
        Width="760"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="DimGray"
                       Text="{Binding MilestoneDescription}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="Source" Padding="14" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Width="120"
                            Margin="16,0,0,0"
                            Content="Select Window"
                            IsEnabled="False" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding SourceStatus}" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Clock Region" Padding="14" Margin="0,0,0,10">
                <TextBlock Text="{Binding ClockRegionStatus}" />
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Minimap Region" Padding="14" Margin="0,0,0,10">
                <TextBlock Text="{Binding MinimapRegionStatus}" />
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Session Status" Padding="14">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Width="120"
                            Margin="16,0,0,0"
                            Content="Start Capture"
                            IsEnabled="False" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding SessionStatus}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="DimGray"
                                   Text="{Binding CliGuidance}" />
                    </StackPanel>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="12"
                Background="#FFF3F4F6"
                CornerRadius="4">
            <TextBlock Foreground="#FF374151"
                       TextWrapping="Wrap"
                       Text="Capture controls are intentionally disabled in this milestone." />
        </Border>
    </Grid>
</Window>
