<Window x:Class="LeagueScreenAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeagueScreenAnalyzer.App"
        Title="{Binding Title}"
        Height="900"
        Width="1280"
        MinHeight="700"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="RegionOverlayStyle" TargetType="ContentControl">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="False">
                            <Border BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    Background="#08000000">
                                <TextBlock Padding="4,1"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Background="#CC111827"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding Label}" />
                            </Border>
                            <Grid Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}">
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           Visibility="{Binding AreEdgeHandlesVisible, Converter={StaticResource BooleanToVisibility}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           Visibility="{Binding AreEdgeHandlesVisible, Converter={StaticResource BooleanToVisibility}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           Visibility="{Binding AreEdgeHandlesVisible, Converter={StaticResource BooleanToVisibility}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3" />
                                <Rectangle Width="6" Height="6" Fill="White" Stroke="{Binding BorderBrush}"
                                           Visibility="{Binding AreEdgeHandlesVisible, Converter={StaticResource BooleanToVisibility}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-3,0,0,0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" MinHeight="180" />
                <RowDefinition Height="2*" MinHeight="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                           Text="{Binding MilestoneDescription}" />
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Source" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Width="130" Height="30" Margin="0,0,8,10"
                            Command="{Binding SelectWindowCommand}" Content="Select Window" />
                    <Button Grid.Column="1" Width="90" Height="30" Margin="0,0,8,10"
                            Command="{Binding StopCaptureCommand}" Content="Stop" />
                    <Button Grid.Column="2" Width="190" Height="30" Margin="0,0,0,10"
                            Command="{Binding SaveDiagnosticFrameCommand}"
                            Content="Save Diagnostic Bundle" />
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Status:" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                               Margin="8,0,0,0">
                        <Run Text="{Binding CaptureStatus, Mode=OneWay}" />
                        <Run Text="  Window: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedSourceName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Frame:" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0,0,0">
                        <Run Text="{Binding FrameDimensions, Mode=OneWay}" />
                        <Run Text="  " />
                        <Run Text="{Binding LatestFrame, Mode=OneWay}" Foreground="DimGray" />
                    </TextBlock>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <Border Background="#FF111827" BorderBrush="#FF374151" BorderThickness="1">
                    <Grid x:Name="PreviewSurface"
                          ClipToBounds="True"
                          SizeChanged="OnPreviewSizeChanged"
                          MouseLeftButtonDown="OnPreviewMouseDown"
                          MouseMove="OnPreviewMouseMove"
                          MouseLeftButtonUp="OnPreviewMouseUp">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF9CA3AF" FontSize="18" Text="Live preview" />
                        <Image Margin="1" Source="{Binding PreviewImage}"
                               Stretch="Uniform" SnapsToDevicePixels="True" />
                        <Canvas Background="Transparent">
                            <ContentControl Style="{StaticResource RegionOverlayStyle}"
                                            DataContext="{Binding ClockOverlay}" />
                            <ContentControl Style="{StaticResource RegionOverlayStyle}"
                                            DataContext="{Binding MinimapOverlay}" />
                        </Canvas>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="RightControlsScrollViewer"
                              Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Configuration and clock recognition">
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <GroupBox x:Name="RegionsGroup"
                              Grid.Row="1"
                              Padding="10"
                              Margin="0,12,0,0">
                        <GroupBox.Header>
                            <TextBlock x:Name="RegionsGroupTitle" Text="Regions" />
                        </GroupBox.Header>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding EditMode}" />
                            <TextBlock Margin="0,3,0,10" Foreground="DimGray"
                                       Text="{Binding RegionValidity}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="#FF8A6500" Text="CLOCK" />
                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                               Text="{Binding ClockCoordinates}" />
                                </StackPanel>
                                <Button x:Name="EditClockRegionButton"
                                        Grid.Column="1" Margin="6,0" Padding="10,4"
                                        Command="{Binding EditClockCommand}" Content="Edit" />
                                <Button Grid.Column="2" Padding="10,4"
                                        Command="{Binding ClearClockCommand}" Content="Clear" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Foreground="#FF006F9E" Text="MINIMAP" />
                                    <TextBlock FontFamily="Consolas" FontSize="11"
                                               Text="{Binding MinimapCoordinates}" />
                                </StackPanel>
                                <Button x:Name="EditMinimapRegionButton"
                                        Grid.Column="1" Margin="6,0" Padding="10,4"
                                        Command="{Binding EditMinimapCommand}" Content="Edit" />
                                <Button Grid.Column="2" Padding="10,4"
                                        Command="{Binding ClearMinimapCommand}" Content="Clear" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" FontWeight="Bold"
                                       Text="{Binding UnsavedStatus}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="LayoutsGroup"
                              Grid.Row="2"
                              Padding="10"
                              Margin="0,12,0,0">
                        <GroupBox.Header>
                            <TextBlock x:Name="LayoutsGroupTitle" Text="Layouts" />
                        </GroupBox.Header>
                        <StackPanel>
                            <TextBlock>
                                <Run Text="Loaded layout: " FontWeight="SemiBold" />
                                <Run Text="{Binding LoadedLayout, Mode=OneWay}" />
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding AvailableSavedLayouts}"
                                      SelectedItem="{Binding SelectedSavedLayout}"
                                      MinWidth="220" />
                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <Button Padding="12,4" Command="{Binding LoadLayoutCommand}" Content="Load" />
                                <Button Margin="7,0,0,0" Padding="12,4"
                                        Command="{Binding DeleteLayoutCommand}" Content="Delete" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,2" Text="Editable new name" />
                            <TextBox Padding="5"
                                     Text="{Binding LayoutName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,5,0,0">
                                <Run Text="Unsaved changes: " FontWeight="SemiBold" />
                                <Run Text="{Binding HasUnsavedChanges, Mode=OneWay}" />
                            </TextBlock>
                            <WrapPanel Margin="0,7,0,0">
                                <Button Padding="12,5" Command="{Binding SaveLayoutCommand}" Content="Save" />
                                <Button Margin="7,0,0,0" Padding="12,5"
                                        Command="{Binding SaveLayoutAsCommand}" Content="Save As" />
                                <Button Margin="7,0,0,0" Padding="12,5"
                                        Command="{Binding ResetToSavedCommand}" Content="Reset to Saved" />
                            </WrapPanel>
                            <Border Margin="0,8,0,0" Padding="8" BorderBrush="#FFD97706"
                                    BorderThickness="1"
                                    Visibility="{Binding IsOverwriteConfirmationVisible, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="#FF92400E" TextWrapping="Wrap"
                                               Text="{Binding OverwriteWarning}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Padding="10,4" Command="{Binding ConfirmOverwriteCommand}"
                                                Content="Confirm Overwrite" />
                                        <Button Margin="6,0,0,0" Padding="10,4"
                                                Command="{Binding CancelOverwriteCommand}" Content="Cancel" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{Binding LayoutValidationMessage}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="MinimapValidationGroup"
                              Grid.Row="3"
                              Padding="10"
                              Margin="0,12,0,0"
                              AutomationProperties.Name="Minimap Validation and Session Recording">
                        <GroupBox.Header>
                            <TextBlock x:Name="MinimapValidationGroupTitle"
                                       Text="Minimap Validation and Session Recording" />
                        </GroupBox.Header>
                        <StackPanel>
                            <CheckBox x:Name="MinimapValidationEnabledToggle"
                                      IsChecked="{Binding MinimapValidationEnabled}"
                                      IsEnabled="{Binding CanConfigureMinimap}"
                                      Content="Enable validation" />
                            <TextBlock x:Name="MinimapProfileLabel"
                                       Margin="0,8,0,2" FontWeight="SemiBold"
                                       Text="Minimap profile" />
                            <ComboBox x:Name="MinimapProfileSelector"
                                      ItemsSource="{Binding AvailableMinimapProfiles}"
                                      DisplayMemberPath="UiLabel"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding MinimapProfileId}"
                                      IsEnabled="{Binding CanConfigureMinimap}"
                                      AutomationProperties.Name="Minimap profile" />
                            <TextBlock x:Name="SelectedMinimapProfileIdText"
                                       Margin="0,4,0,0" Foreground="DimGray"
                                       FontFamily="Consolas" TextWrapping="Wrap">
                                <Run Text="ID: " />
                                <Run FontWeight="Bold" Text="{Binding MinimapProfileId, Mode=OneWay}" />
                                <Run Text="  Version: " />
                                <Run Text="{Binding MinimapProfileVersion, Mode=OneWay}" />
                                <Run Text="  Calibration: " />
                                <Run Text="{Binding MinimapCalibrationStatus, Mode=OneWay}" />
                                <Run Text="  Active: " />
                                <Run FontWeight="Bold" Text="{Binding ActiveMinimapProfileId, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock x:Name="MinimapProfileSourceText"
                                       Margin="0,3,0,0" Foreground="DimGray"
                                       FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                       Text="{Binding MinimapProfileSource}" />
                            <TextBlock x:Name="MinimapProfileWarningText"
                                       Margin="0,3,0,0" Foreground="#FFB91C1C"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding MinimapProfileWarning}" />
                            <Border x:Name="MinimapValidationStatusPanel"
                                    Margin="0,8,0,0" Padding="8"
                                    Background="#FFF3F4F6" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock>
                                        <Run FontWeight="SemiBold" Text="Status: " />
                                        <Run FontWeight="Bold" Text="{Binding MinimapStatus, Mode=OneWay}" />
                                        <Run Text="  Confidence: " />
                                        <Run Text="{Binding MinimapConfidence, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="11"
                                               Text="{Binding MinimapFeatures}" />
                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="DimGray" Text="{Binding MinimapReason}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="MinimapSampleLabel"
                                       Margin="0,9,0,2" FontWeight="SemiBold"
                                       Text="Explicit sample label" />
                            <ComboBox ItemsSource="{Binding MinimapLabels}"
                                      SelectedItem="{Binding SelectedMinimapLabel}"
                                      AutomationProperties.Name="Minimap sample label" />
                            <CheckBox Margin="0,6,0,0"
                                      IsChecked="{Binding SaveUnlabeledMinimapSample}"
                                      Content="Explicit unlabeled diagnostic mode" />
                            <WrapPanel Margin="0,7,0,0">
                                <Button x:Name="SaveMinimapSampleButton"
                                        Margin="0,0,6,6" Padding="10,4"
                                        Command="{Binding SaveMinimapSampleCommand}"
                                        Content="Save Labeled Minimap Sample" />
                                <Button x:Name="SaveMinimapDiagnosticButton"
                                        Margin="0,0,0,6" Padding="10,4"
                                        Command="{Binding SaveMinimapDiagnosticCommand}"
                                        Content="Save Minimap Diagnostic" />
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="Session mode" />
                            <ComboBox ItemsSource="{Binding SessionModes}"
                                      SelectedItem="{Binding SelectedSessionMode}"
                                      IsEnabled="{Binding CanConfigureMinimap}" />
                            <TextBlock Margin="0,7,0,2" FontWeight="SemiBold"
                                       Text="Game-time cadence (milliseconds)" />
                            <ComboBox ItemsSource="{Binding ObservationCadencesMilliseconds}"
                                      SelectedItem="{Binding ObservationCadenceMilliseconds}"
                                      IsEnabled="{Binding CanConfigureMinimap}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="StartSessionRecordingButton"
                                        Margin="0,0,6,6" Padding="10,4"
                                        Command="{Binding StartSessionRecordingCommand}"
                                        Content="Start Session Recording" />
                                <Button x:Name="StopSessionRecordingButton"
                                        Margin="0,0,6,6" Padding="10,4"
                                        Command="{Binding StopSessionRecordingCommand}"
                                        Content="Stop" />
                                <Button x:Name="OpenSessionFolderButton"
                                        Margin="0,0,0,6" Padding="10,4"
                                        Command="{Binding OpenSessionFolderCommand}"
                                        Content="Open Folder" />
                            </WrapPanel>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Recording: " />
                                <Run Text="{Binding RecordingStatus, Mode=OneWay}" />
                                <Run Text="  Game time: " />
                                <Run FontFamily="Consolas" Text="{Binding CurrentAcceptedGameTime, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="Valid: " />
                                <Run Text="{Binding ValidObservationCount, Mode=OneWay}" />
                                <Run Text="  Unavailable: " />
                                <Run Text="{Binding UnavailableObservationCount, Mode=OneWay}" />
                                <Run Text="  Saved frames: " />
                                <Run Text="{Binding SavedMapFrameCount, Mode=OneWay}" />
                                <Run Text="  Gaps: " />
                                <Run Text="{Binding GapCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="First: " />
                                <Run FontFamily="Consolas" Text="{Binding FirstAcceptedGameTime, Mode=OneWay}" />
                                <Run Text="  Last: " />
                                <Run FontFamily="Consolas" Text="{Binding LastAcceptedGameTime, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="Achieved game-time resolution: " />
                                <Run Text="{Binding AchievedGameTimeResolution, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="10"
                                       Text="{Binding SessionOutputPath}" />
                            <TextBlock Margin="0,5,0,0" Foreground="#FFB45309"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding SessionWarning}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="ClockRecognitionGroup"
                              Grid.Row="0"
                              Padding="7"
                              AutomationProperties.Name="Clock Recognition">
                        <GroupBox.Header>
                            <TextBlock x:Name="ClockRecognitionGroupTitle"
                                       Text="Clock Recognition" />
                        </GroupBox.Header>
                        <StackPanel>
                            <CheckBox x:Name="RecognitionEnabledToggle"
                                      IsChecked="{Binding RecognitionEnabled}"
                                      Content="Enable recognition" />
                            <TextBlock Margin="0,8,0,2" FontWeight="SemiBold" Text="Profile" />
                            <ComboBox x:Name="ClockProfileSelector"
                                      ItemsSource="{Binding AvailableClockProfiles}"
                                      DisplayMemberPath="UiLabel"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedClockProfileId}"
                                      IsEnabled="{Binding CanConfigureClockRecognition}"
                                      AutomationProperties.Name="Clock recognition profile" />
                            <TextBlock x:Name="ClockProfileWarningText"
                                       Foreground="#FFB45309" TextWrapping="Wrap"
                                       Text="{Binding ClockProfileWarning}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,3,0,0" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,8,0,2" FontWeight="SemiBold"
                                       Text="Fixed playback speed" />
                            <ComboBox x:Name="PlaybackSpeedSelector"
                                      ItemsSource="{Binding PlaybackSpeeds}"
                                      SelectedItem="{Binding SelectedPlaybackSpeed}"
                                      IsEnabled="{Binding CanConfigureClockRecognition}"
                                      AutomationProperties.Name="Playback speed" />
                            <TextBlock x:Name="SelectedClockProfileIdText"
                                       Margin="0,4,0,8" Foreground="DimGray"
                                       FontFamily="Consolas">
                                <Run Text="Speed: " />
                                <Run Text="{Binding PlaybackSpeedDisplay, Mode=OneWay}"
                                     FontWeight="Bold" />
                                <Run Text="  ID: " />
                                <Run Text="{Binding SelectedClockProfileId, Mode=OneWay}"
                                     FontWeight="Bold" />
                                <Run Text="  Templates: " />
                                <Run Text="{Binding SelectedClockProfileTemplateCount, Mode=OneWay}" />
                                <Run Text="  Active: " />
                                <Run Text="{Binding ActiveClockProfileId, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                            <Border Padding="8" Background="#FFF3F4F6" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="Current status:" />
                                    <TextBlock x:Name="ClockStatusText"
                                               Grid.Column="1" Margin="7,0,0,0"
                                               FontWeight="Bold" Text="{Binding ClockStatus}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFB91C1C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClockStatus}" Value="Valid">
                                                        <Setter Property="Foreground" Value="#FF15803D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" FontWeight="SemiBold"
                                               Text="Recognized candidate:" />
                                    <TextBlock x:Name="ClockRecognizedCandidateText"
                                               Grid.Row="1" Grid.Column="1" Margin="7,0,0,0"
                                               FontFamily="Consolas" Text="{Binding ClockRecognizedText}" />
                                    <TextBlock Grid.Row="2" FontWeight="SemiBold"
                                               Text="Accepted game time:" />
                                    <TextBlock x:Name="ClockAcceptedGameTimeText"
                                               Grid.Row="2" Grid.Column="1" Margin="7,0,0,0"
                                               FontFamily="Consolas" Text="{Binding ClockAcceptedTime}" />
                                    <TextBlock Grid.Row="3" FontWeight="SemiBold"
                                               Text="Historical game time:" />
                                    <TextBlock x:Name="ClockHistoricalGameTimeText"
                                               Grid.Row="3" Grid.Column="1" Margin="7,0,0,0"
                                               FontFamily="Consolas" Text="{Binding ClockHistoricalTime}" />
                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Confidence:" />
                                    <TextBlock x:Name="ClockConfidenceText"
                                               Grid.Row="4" Grid.Column="1" Margin="7,0,0,0"
                                               Text="{Binding ClockConfidence}" />
                                    <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Cadence:" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="7,0,0,0"
                                               Text="{Binding RecognitionCadence}" />
                                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Accepted source:" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="7,0,0,0"
                                               FontFamily="Consolas" Text="{Binding ClockLastAcceptedSourceTime}" />
                                    <TextBlock x:Name="ClockDiagnosticText"
                                               Grid.Row="7" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Foreground="DimGray"
                                               Text="{Binding ClockDiagnostic}"
                                               AutomationProperties.Name="Diagnostic or rejection reason" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,8,0,2" FontWeight="SemiBold"
                                       Text="Actual clock value" />
                            <TextBox x:Name="ActualClockValueTextBox"
                                     Text="{Binding ActualClockValue, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Actual clock value"
                                     ToolTip="Enter the visible replay time as M:SS or MM:SS." />
                            <TextBlock x:Name="ClockLabelValidationText"
                                       Margin="0,3,0,0"
                                       Foreground="#FFB91C1C"
                                       TextWrapping="Wrap"
                                       Text="{Binding ClockLabelValidationMessage}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <CheckBox x:Name="SaveUnlabeledClockSampleCheckBox"
                                      Margin="0,7,0,0"
                                      IsChecked="{Binding SaveUnlabeledClockSample}"
                                      Content="Save as unlabeled diagnostic only" />
                            <Button x:Name="SaveClockSampleButton"
                                    Margin="0,8,0,0" Padding="12,5"
                                    Command="{Binding SaveClockSampleCommand}"
                                    Content="Save Clock Sample" />
                        </StackPanel>
                    </GroupBox>
                  </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="CLOCK crop" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:AspectRatioDecorator AspectRatio="3.2">
                            <local:CropPreviewControl x:Name="ClockCropPreview"
                                                      ImageSource="{Binding ClockCrop.Image}" />
                        </local:AspectRatioDecorator>
                        <TextBlock Grid.Row="1" Margin="0,5,0,0"
                                   Text="{Binding ClockCrop.Dimensions}" />
                        <TextBlock Grid.Row="2" FontFamily="Consolas"
                                   Text="{Binding ClockCrop.Coordinates}" />
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="MINIMAP crop" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:AspectRatioDecorator AspectRatio="1">
                            <local:CropPreviewControl x:Name="MinimapCropPreview"
                                                      ImageSource="{Binding MinimapCrop.Image}" />
                        </local:AspectRatioDecorator>
                        <TextBlock Grid.Row="1" Margin="0,5,0,0"
                                   Text="{Binding MinimapCrop.Dimensions}" />
                        <TextBlock Grid.Row="2" FontFamily="Consolas"
                                   Text="{Binding MinimapCrop.Coordinates}" />
                    </Grid>
                </GroupBox>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Foreground="#FFB45309" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="{Binding CompatibilityWarning}" />
                <TextBlock Foreground="#FFB91C1C" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                           TextWrapping="Wrap" Text="{Binding DiagnosticMessage}" />
                <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                           Text="Tip: Edit opens the frozen precision view. Arrow keys move 1 px (Shift: 10 px); Alt+Arrow resizes 1 px (Shift+Alt: 10 px). MINIMAP resize keeps its top-left anchor and stays square." />
            </StackPanel>

            <Border Grid.RowSpan="5" Panel.ZIndex="{Binding PrecisionEditorZIndex}" Margin="35"
                    Padding="14" Background="#FFF9FAFB" BorderBrush="#FF374151"
                    BorderThickness="2"
                    IsHitTestVisible="{Binding IsPrecisionEditing}"
                    Visibility="{Binding IsPrecisionEditing, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock FontSize="20" FontWeight="SemiBold"
                                   Text="{Binding PrecisionEditorTitle}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Run Text="Frozen source · Zoom " />
                            <Run Text="{Binding PrecisionZoom, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#FF111827" BorderBrush="#FF6B7280"
                            BorderThickness="1" Padding="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False">
                            <Grid Width="{Binding PrecisionContextWidth}"
                                  Height="{Binding PrecisionContextHeight}"
                                  RenderOptions.BitmapScalingMode="NearestNeighbor">
                                <Image Source="{Binding PrecisionFrozenImage}" Stretch="Fill"
                                       SnapsToDevicePixels="True" />
                                <Canvas Background="Transparent"
                                        MouseLeftButtonDown="OnPrecisionMouseDown"
                                        MouseMove="OnPrecisionMouseMove"
                                        MouseLeftButtonUp="OnPrecisionMouseUp">
                                    <Border Canvas.Left="{Binding PrecisionOverlayLeft}"
                                            Canvas.Top="{Binding PrecisionOverlayTop}"
                                            Width="{Binding PrecisionOverlayWidth}"
                                            Height="{Binding PrecisionOverlayHeight}"
                                            BorderBrush="{Binding PrecisionBorderBrush}"
                                            BorderThickness="1"
                                            Background="#10000000">
                                        <Rectangle Width="3" Height="3" Fill="White"
                                                   Stroke="{Binding PrecisionBorderBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,-2,-2" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock VerticalAlignment="Center" Text="X" />
                                <TextBox Width="64" Margin="4,0,10,0" Padding="4"
                                         Text="{Binding PixelX, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock VerticalAlignment="Center" Text="Y" />
                                <TextBox Width="64" Margin="4,0,10,0" Padding="4"
                                         Text="{Binding PixelY, UpdateSourceTrigger=LostFocus}" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsClockPrecisionEdit, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock VerticalAlignment="Center" Text="Width" />
                                    <TextBox Width="64" Margin="4,0,10,0" Padding="4"
                                             Text="{Binding PixelWidth, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock VerticalAlignment="Center" Text="Height" />
                                    <TextBox Width="64" Margin="4,0,10,0" Padding="4"
                                             Text="{Binding PixelHeight, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock VerticalAlignment="Center" Text="Ratio" />
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
                                               FontFamily="Consolas" Text="{Binding PixelRatio}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsMinimapPrecisionEdit, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock VerticalAlignment="Center" Text="Size" />
                                    <TextBox Width="64" Margin="4,0,0,0" Padding="4"
                                             Text="{Binding PixelSize, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Margin="0,6,0,0" Text="{Binding PixelGeometryStatus}" />
                            <TextBlock Foreground="#FFB91C1C" TextWrapping="Wrap"
                                       Text="{Binding PixelValidationMessage}" />
                            <TextBlock Margin="0,5,0,0" Foreground="DimGray"
                                       Text="Move: Arrow 1 px / Shift+Arrow 10 px. Resize: Alt+Arrow 1 px / Shift+Alt+Arrow 10 px. Drag inside to move; drag the lower-right marker to resize." />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                            <Button Padding="12,5" Command="{Binding UndoCurrentEditCommand}"
                                    Content="Undo Current Edit" />
                            <Button Margin="7,0,0,0" Padding="12,5"
                                    Command="{Binding CancelRegionEditCommand}" Content="Cancel" />
                            <Button Margin="7,0,0,0" Padding="12,5"
                                    Command="{Binding ApplyRegionEditCommand}" Content="Apply" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Window>
