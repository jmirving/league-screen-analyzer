<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LeagueScreenAnalyzer.Core\LeagueScreenAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Capture\LeagueScreenAnalyzer.Capture.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Imaging\LeagueScreenAnalyzer.Imaging.csproj" />
    <ProjectReference Include="..\LeagueScreenAnalyzer.Storage\LeagueScreenAnalyzer.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\fixtures\clocks\**\*"
             Link="fixtures\clocks\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\fixtures\minimaps\**\*"
             Link="fixtures\minimaps\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
